<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TactTalk | Speech to Vibration</title>
  <style>
    :root {
      --bg-1: #07111f;
      --bg-2: #0c1726;
      --bg-3: #121b2d;
      --panel: rgba(12, 22, 35, 0.72);
      --panel-border: rgba(148, 163, 184, 0.18);
      --text: #edf6ff;
      --muted: #9db0ca;
      --primary: #4f8cff;
      --secondary: #7c4dff;
      --success: #32d194;
      --danger: #ff5f7a;
      --warning: #ffbb55;
      --shadow: rgba(34, 72, 137, 0.35);
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      min-height: 100%;
      font-family: Inter, "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at 12% 15%, rgba(79, 140, 255, 0.26), transparent 28%),
        radial-gradient(circle at 82% 80%, rgba(124, 77, 255, 0.22), transparent 22%),
        linear-gradient(140deg, var(--bg-1), var(--bg-2) 45%, var(--bg-3));
      color: var(--text);
    }

    body {
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 24px;
      overflow: hidden;
    }

    body::before,
    body::after {
      content: "";
      position: fixed;
      width: 38rem;
      height: 38rem;
      border-radius: 50%;
      filter: blur(90px);
      opacity: 0.45;
      pointer-events: none;
    }

    body::before {
      background: rgba(79, 140, 255, 0.18);
      top: -14rem;
      left: -8rem;
    }

    body::after {
      background: rgba(124, 77, 255, 0.17);
      bottom: -14rem;
      right: -9rem;
    }

    .app {
      position: relative;
      width: min(92vw, 760px);
      padding: 30px 28px 26px;
      border-radius: 28px;
      background: var(--panel);
      border: 1px solid var(--panel-border);
      box-shadow: 0 32px 90px var(--shadow);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      overflow: hidden;
    }

    .app::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,0.08), transparent 38%, rgba(255,255,255,0.02));
      pointer-events: none;
    }

    .topbar, .panel, .wavebar, .transcript-box, .status {
      position: relative;
      z-index: 1;
    }

    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 18px;
      margin-bottom: 12px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .brand-mark {
      width: 48px;
      height: 48px;
      border-radius: 16px;
      display: grid;
      place-items: center;
      font-weight: 800;
      letter-spacing: 0.08em;
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      box-shadow: 0 18px 28px rgba(79, 140, 255, 0.32);
    }

    small {
      display: block;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.68rem;
    }

    h1 {
      margin: 0;
      font-size: clamp(1.7rem, 3vw, 2.5rem);
      letter-spacing: -0.05em;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border-radius: 999px;
      border: 1px solid rgba(148, 163, 184, 0.18);
      background: rgba(148, 163, 184, 0.08);
      color: var(--muted);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .status-pill::before {
      content: "";
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--warning);
      box-shadow: 0 0 12px rgba(255, 187, 85, 0.9);
    }

    .status-pill.ready::before {
      background: var(--success);
      box-shadow: 0 0 12px rgba(50, 209, 148, 0.9);
    }

    .status-pill.live::before {
      background: var(--danger);
      box-shadow: 0 0 12px rgba(255, 95, 122, 0.9);
    }

    .sub {
      margin: 0 0 20px;
      color: var(--muted);
      font-size: 1.02rem;
      letter-spacing: 0.02em;
    }

    .panel {
      border-radius: 22px;
      background: rgba(7, 17, 31, 0.35);
      border: 1px solid rgba(148, 163, 184, 0.1);
      padding: 18px;
      margin-bottom: 16px;
    }

    .label {
      display: block;
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 10px;
    }

    .controls {
      display: grid;
      gap: 12px;
      grid-template-columns: minmax(0, 1fr) auto;
      margin-bottom: 14px;
    }

    input {
      width: 100%;
      border: 1px solid rgba(148, 163, 184, 0.18);
      border-radius: 14px;
      background: rgba(15, 23, 42, 0.92);
      color: var(--text);
      padding: 14px 16px;
      font-size: 1rem;
      outline: none;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    input:focus {
      border-color: rgba(79, 140, 255, 0.8);
      box-shadow: 0 0 0 4px rgba(79, 140, 255, 0.12);
    }

    button {
      border: none;
      border-radius: 14px;
      cursor: pointer;
      font: inherit;
      transition: transform 0.18s ease, box-shadow 0.18s ease, opacity 0.2s ease;
    }

    button:hover:not(:disabled) {
      transform: translateY(-1px);
    }

    #connectBtn {
      background: linear-gradient(135deg, var(--primary), var(--secondary));
      color: white;
      font-weight: 700;
      padding: 13px 18px;
      box-shadow: 0 15px 26px rgba(79, 140, 255, 0.28);
    }

    #micBtn {
      width: 100%;
      background: linear-gradient(135deg, #ff5f7a, #ff9a54);
      color: white;
      font-weight: 800;
      padding: 16px 18px;
      box-shadow: 0 18px 28px rgba(255, 95, 122, 0.26);
    }

    #micBtn:disabled {
      cursor: not-allowed;
      opacity: 0.6;
      box-shadow: none;
    }

    #micBtn.listening {
      background: linear-gradient(135deg, #26d07c, #1aa46f);
      box-shadow: 0 18px 28px rgba(38, 208, 124, 0.28);
    }

    .wavebar {
      display: flex;
      justify-content: center;
      align-items: end;
      gap: 7px;
      height: 42px;
      margin: 8px 0 18px;
      opacity: 0.35;
    }

    .wavebar.active {
      opacity: 1;
      filter: drop-shadow(0 0 18px rgba(79, 140, 255, 0.35));
    }

    .wavebar span {
      display: block;
      width: 8px;
      border-radius: 999px;
      background: linear-gradient(180deg, rgba(96, 165, 250, 1), rgba(124, 77, 255, 0.6));
      animation: wave 1.1s ease-in-out infinite alternate;
    }

    .wavebar span:nth-child(1) { height: 18%; animation-delay: 0s; }
    .wavebar span:nth-child(2) { height: 42%; animation-delay: 0.08s; }
    .wavebar span:nth-child(3) { height: 72%; animation-delay: 0.16s; }
    .wavebar span:nth-child(4) { height: 100%; animation-delay: 0.24s; }
    .wavebar span:nth-child(5) { height: 72%; animation-delay: 0.32s; }
    .wavebar span:nth-child(6) { height: 42%; animation-delay: 0.4s; }
    .wavebar span:nth-child(7) { height: 18%; animation-delay: 0.48s; }

    .transcript-box {
      border-radius: 20px;
      border: 1px solid rgba(148, 163, 184, 0.12);
      background: rgba(7, 17, 31, 0.45);
      padding: 18px 18px 16px;
    }

    #transcript {
      min-height: 56px;
      font-size: clamp(1.1rem, 2vw, 1.7rem);
      line-height: 1.4;
      letter-spacing: -0.02em;
    }

    .status {
      margin-top: 14px;
      min-height: 22px;
      color: var(--muted);
      font-size: 0.92rem;
    }

    @keyframes wave {
      0% { transform: scaleY(0.55); opacity: 0.55; }
      100% { transform: scaleY(1); opacity: 1; }
    }

    @media (max-width: 560px) {
      .app {
        padding: 22px 18px 18px;
      }

      .topbar {
        flex-direction: column;
        align-items: flex-start;
      }

      .controls {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <div class="app">
    <header class="topbar">
      <div class="brand">
        <div class="brand-mark">T</div>
        <div>
          <small>Smart wearable</small>
          <h1>TactTalk</h1>
        </div>
      </div>
      <div id="statusPill" class="status-pill">Offline</div>
    </header>

    <p class="sub">Speak naturally and let the vibration translate your words.</p>

    <div class="panel">
      <label class="label" for="ipInput">ESP32 IP</label>
      <div class="controls">
        <input id="ipInput" type="text" placeholder="192.168.1.42" autocomplete="off" />
        <button id="connectBtn" type="button">Save IP</button>
      </div>
      <button id="micBtn" type="button" disabled>Hold to Speak</button>
    </div>

    <div id="wavebar" class="wavebar" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
    </div>

    <div class="transcript-box">
      <div class="label">Live transcript</div>
      <div id="transcript">Say something...</div>
    </div>

    <div id="status" class="status">Not connected</div>
  </div>

  <script>
    const storageKey = 'tacttalk-esp32-ip';
    let esp32IP = localStorage.getItem(storageKey) || '';
    let recognition = null;
    let isListening = false;

    const connectBtn = document.getElementById('connectBtn');
    const micBtn = document.getElementById('micBtn');
    const ipInput = document.getElementById('ipInput');
    const transcriptEl = document.getElementById('transcript');
    const statusEl = document.getElementById('status');
    const statusPill = document.getElementById('statusPill');
    const wavebar = document.getElementById('wavebar');

    function setStatus(message, mode = 'idle') {
      statusEl.textContent = message;
      statusPill.classList.remove('ready', 'live');

      if (mode === 'ready') {
        statusPill.classList.add('ready');
        statusPill.textContent = 'Ready';
      } else if (mode === 'live') {
        statusPill.classList.add('live');
        statusPill.textContent = 'Live';
      } else {
        statusPill.textContent = 'Offline';
      }
    }

    function stopListeningUI() {
      isListening = false;
      micBtn.classList.remove('listening');
      micBtn.textContent = 'Hold to Speak';
      wavebar.classList.remove('active');
    }

    function setupRecognition() {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) {
        setStatus('Speech recognition is not supported in this browser.', 'idle');
        return null;
      }

      recognition = new SpeechRecognition();
      recognition.continuous = false;
      recognition.interimResults = false;
      recognition.lang = 'en-US';

      recognition.onresult = (event) => {
        const transcript = Array.from(event.results)
          .map(result => result[0].transcript)
          .join(' ')
          .trim();

        if (!transcript) return;

        transcriptEl.textContent = transcript;
        sendToESP32(transcript);
      };

      recognition.onerror = (event) => {
        setStatus('Speech error: ' + event.error, 'idle');
        stopListeningUI();
      };

      recognition.onend = () => {
        stopListeningUI();
      };

      return recognition;
    }

    if (esp32IP) {
      ipInput.value = esp32IP;
      micBtn.disabled = false;
      setStatus('Using saved ESP32 IP ✓', 'ready');
    }

    connectBtn.addEventListener('click', () => {
      esp32IP = ipInput.value.trim();

      if (!esp32IP) {
        setStatus('Enter the ESP32 IP address first', 'idle');
        return;
      }

      localStorage.setItem(storageKey, esp32IP);
      micBtn.disabled = false;
      setStatus('Using ESP32 at ' + esp32IP + ' ✓', 'ready');
    });

    micBtn.addEventListener('click', () => {
      if (!esp32IP) {
        setStatus('Save the ESP32 IP before speaking.', 'idle');
        return;
      }

      if (!recognition) {
        recognition = setupRecognition();
      }

      if (!recognition) return;

      if (!isListening) {
        isListening = true;
        micBtn.classList.add('listening');
        micBtn.textContent = 'Listening...';
        wavebar.classList.add('active');
        transcriptEl.textContent = 'Listening...';
        setStatus('Listening for speech...', 'live');
        recognition.start();
      } else {
        recognition.stop();
      }
    });

    async function sendToESP32(text) {
      if (!esp32IP) {
        setStatus('Enter and save the ESP32 IP first!', 'idle');
        return;
      }

      try {
        const url = `http://${esp32IP}/say?word=${encodeURIComponent(text)}`;
        const response = await fetch(url);
        const result = await response.text();
        setStatus('Sent: "' + text + '" — ' + result, 'ready');
      } catch (err) {
        setStatus('Failed to reach ESP32: ' + err, 'idle');
      }
    }
  </script>
</body>
</html>
